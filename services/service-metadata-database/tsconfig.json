{   
    "compilerOptions": {
        "outDir": "./lib",
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "importHelpers": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "noImplicitAny": false,
        "declaration": true,
        "noFallthroughCasesInSwitch": true,
        //"noImplicitReturns": true,
        "stripInternal": true,
        "pretty": true,
        "strictNullChecks": false,
        "noUnusedLocals": true,
        "downlevelIteration": true,
        "skipLibCheck": true,
        "lib": [
          "ES2022"
        ],
        "types": ["node"],
        "removeComments": true
    },
    "include": [
      "./src/**/*"
    ]
  }