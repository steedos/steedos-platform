                                                },
                                                {
                                                    "actionType": "setValue",
                                                    "componentId": "u:f6a209c8cf61",
                                                    "args": {
                                                        "value": {
                                                            "isVisible": "${!isVisible}"
                                                        }
                                                    }
                                                },
                                                {
                                                    "actionType": "setValue",
                                                    "componentId": "u:f6a209c8cf61",
                                                    "args": {
                                                        "value": {
                                                            "additionalFilters": [
                                                                "organizations_parents",
                                                                "in",
                                                                "${event.data.value.value | asArray}"
                                                            ],
                                                            "organizations": "${event.data.value.value}"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
