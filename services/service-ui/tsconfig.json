{   
  "compilerOptions": {
      "outDir": "./main/default/routes",
      "target": "ES2022",
      "module": "commonjs",
      "moduleResolution": "node",
      "importHelpers": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": false,
      "declarationMap": false,
      "noImplicitAny": false,
      "declaration": true,
      "noFallthroughCasesInSwitch": true,
      //"noImplicitReturns": true,
      "stripInternal": true,
      "pretty": true,
      "noUnusedLocals": true,
      "downlevelIteration": true,
      "strictNullChecks": false,
      "skipLibCheck": true,
      "lib": [
        "ES2022"
      ],
      "types": ["node"],
      "removeComments": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "../../node_modules/"
  ]
}