{
  "name": "steedos-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "ee/*",
    "builder6/*"
  ],
  "scripts": {
    "clean": "lerna clean",
    "start": "pnpm --dir builder6/server start",
    "webapp": "pnpm --dir builder6/webapp dev",
    "build": "lerna run build",
    "docker": "docker-compose up",
    "docker:db": "docker-compose up mongodb mongodb-init redis nats",
    "i18n": "lerna run i18n",
    "repl": "moleculer-runner  --config steedos.config.js --repl",
    "sync": "lerna exec --no-private  -- cnpm sync \\$LERNA_PACKAGE_NAME",
    "release:beta": "pnpm lerna publish --force-publish --exact --dist-tag beta --registry https://registry.npmjs.org",
    "release:again": "lerna publish from-package --registry https://registry.npmjs.org",
    "depcheck:services": "depcheck services/* --json > depcheck-services-result.json",
    "depcheck:packages": "depcheck packages/* --json > depcheck-packages-result.json",
    "validate:package": "steedos-validate"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-angular": "^20.2.0",
    "@eslint/js": "^9.22.0",
    "@types/node": "^18.0.3",
    "cnpm": "^9.0.1",
    "concurrently": "^8.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "lerna": "^9.0.3",
    "nodemon": "^3.1.11",
    "rimraf": "^6.0.1",
    "tslib": "^2.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "@steedos/objectql": "link:packages/objectql",
      "@steedos/router": "link:packages/router",
      "@steedos/service-package-loader": "link:services/service-package-loader",
      "@steedos/service-package-registry": "link:services/service-package-registry",
      "@steedos/service-ui": "link:services/service-ui",
      "graphql": "15.10.2"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
