{
  "name": "steedos-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "ee/*",
    "builder6/*"
  ],
  "scripts": {
    "clean": "lerna clean",
    "start": "cd builder6/server && yarn start",
    "webapp": "cd builder6/webapp && yarn dev",
    "build": "lerna run build",
    "docker": "docker-compose up",
    "docker:db": "docker-compose up mongodb mongodb-init redis nats",
    "i18n": "lerna run i18n",
    "repl": "moleculer-runner  --config steedos.config.js --repl",
    "sync": "lerna exec --no-private  -- cnpm sync \\$LERNA_PACKAGE_NAME",
    "prepare": "husky install",
    "release:beta": "yarn lerna publish --force-publish --exact --dist-tag beta --registry https://registry.npmjs.org",
    "release:again": "lerna publish from-package --registry https://registry.npmjs.org",
    "depcheck:services": "depcheck services/* --json > depcheck-services-result.json",
    "depcheck:packages": "depcheck packages/* --json > depcheck-packages-result.json",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit -p tsconfig.strict.json"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-angular": "^20.2.0",
    "@eslint/js": "^9.22.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.0.3",
    "cnpm": "^9.0.1",
    "concurrently": "^8.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lerna": "^9.0.3",
    "lint-staged": "15.4.3",
    "nodemon": "^3.1.11",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.2",
    "tslib": "^2.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@3.8.7"
}
