{
  "compilerOptions": {
    "outDir": "./lib",
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "removeComments": true
  },
  "include": ["./src/**/*"]
}
