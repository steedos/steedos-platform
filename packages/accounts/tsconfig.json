    "resolveJsonModule": true,
    "outDir": "./lib",
    "target": "ES2022",
    "allowJs": true,
    "lib": ["es2015", "esnext.asynciterable"],
    "sourceMap": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "removeComments": true
  },
  "include": ["./src/**/*"]
}
