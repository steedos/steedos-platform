{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "noImplicitAny": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "declaration": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "stripInternal": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "newLine": "LF",
        "lib": [
            "ES2022"
        ],
        "types": ["node"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "removeComments": true
    },
    "include": [
        "./src"
    ],
    "exclude": [
      "**/node_modules",
      "**/*.spec.ts"
    ]
}
