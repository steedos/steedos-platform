{
  "name": "@steedos/filters",
  "version": "3.0.15-beta.6",
  "description": "filters lib for steedos",
  "main": "lib/index.js",
  "files": [
    "lib",
    "dist"
  ],
  "license": "Apache",
  "scripts": {
    "test": "pnpm build-babel && mocha test/**/*.js",
    "build": "pnpm build-babel && pnpm build-rollup && pnpm build-uglifyjs && pnpm build-assets",
    "build-babel": "babel -d lib src/",
    "build-rollup": "rollup -c rollup.config.js",
    "build-uglifyjs": "pnpm exec uglifyjs dist/steedos-filters.umd.js -o dist/steedos-filters.umd.min.js",
    "build-assets": "cp src/assets.json dist"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "lodash": "4.17.21",
    "moment": "^2.24.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.8.4",
    "@babel/plugin-proposal-class-properties": "^7.8.4",
    "@babel/plugin-proposal-json-strings": "^7.8.4",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.8.4",
    "@babel/plugin-transform-runtime": "^7.8.4",
    "@babel/preset-env": "^7.8.4",
    "@babel/register": "^7.8.4",
    "@types/uglify-js": "^3",
    "rollup": "^4.52.4",
    "uglify-js": "^3.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "cd3a60e242eed4ae305077393f0785ddb79f17de"
}
